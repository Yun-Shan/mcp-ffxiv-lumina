                  "content": "{\"ID\":90,\"LodestoneID\":\"ee802d0c0ef\",\"类型ID\":2,\"类型\":\"迷宫挑战\",\"类内排序\":98,\"中文名\":\"间歇灵泉哈姆岛\",\"日文名\":\"星霊間欠 ハーム島\",\"英文名\":\"the Aetherfont\",\"描述\":\"哈姆岛，与萨雷安本岛相连的岛屿之一。哈姆岛地下喷涌着肉眼可见的高浓度以太，拥有极高的学术价值，因此被划为哲学家议会的直辖地，长年处于管制之下，不得随意出入。在这以太丰沛的环境中，由各种野生生物构筑起了独特的生态系统，其中不乏性情凶猛的物种。但危机当前不容退却，为了获取足以开启虚无界之门的以太量，前往这个危险岛屿的最深处吧！\",\"图片\":112521,\"版本\":6.4,\"最低等级\":90,\"最高等级\":90,\"时间\":90,\"中途加入\":true,\"最低装备品级\":605,\"最高装备品级\":0,\"新手奖励金币\":0,\"新手奖励经验值\":0,\"新手奖励货币A\":70,\"新手奖励货币B\":0,\"团队\":false,\"防护\":1,\"治疗\":1,\"近战\":1,\"远程\":1,\"小队数量\":1,\"解除人数限制\":true,\"地点\":\"哈姆岛\",\"MapID\":831,\"MapPlaceName\":\"哈姆岛\",\"保持超越之力\":0,\"叠加超越之力\":0,\"不死鸟之尾\":true,\"BOSS\":{\"中文名id\":[12334],\"直接奖励\":[{\"有几率掉落\":true,\"掉落物品\":40605,\"每周限定一个\":false,\"前置任务\":65973,\"掉落数量\":1}],\"宝箱\":[{\"掉落物品\":[40241,40246,40251,40261,40256,40271,40266,40243,40248,40253,40263,40258,40273,40268,40369,40706],\"每周限定id\":-1}],\"中文名\":[\"八足巨妖\"],\"货币A\":35,\"货币B\":0,\"货币C\":0},\"道中BOSS\":[{\"中文名id\":[12336],\"直接奖励\":[],\"宝箱\":[{\"掉落物品\":[40240,40245,40250,40260,40255,40270,40265,40241,40246,40251,40261,40256,40271,40266,40285,40286,40287,40289,40288,40290,40291,40292,40294,40293,33919,33920,33918,33928,33929,33921,33917],\"每周限定id\":-1}],\"中文名\":[\"林巴克尔\"],\"货币A\":15,\"货币B\":0,\"货币C\":0},{\"中文名id\":[12337],\"直接奖励\":[],\"宝箱\":[{\"掉落物品\":[40242,40247,40252,40262,40257,40272,40267,40244,40249,40254,40264,40259,40274,40269,40275,40276,40277,40279,40278,40280,40281,40282,40284,40283],\"每周限定id\":-1}],\"中文名\":[\"阿尔卡斯\"],\"货币A\":20,\"货币B\":0,\"货币C\":0}],\"地图信息\":[{\"掉落物品\":[40242,40247,40252,40262,40257,40272,40267,40285,40286,40287,40289,40288,40290,40291,40292,40294,40293,33919,33920,33918,33928,33929,33921,33917],\"每周限定id\":-1,\"坐标X\":10.1,\"坐标Y\":15.5},{\"掉落物品\":[40244,40249,40254,40264,40259,40274,40269,40275,40276,40277,40279,40278,40280,40281,40282,40284,40283,33919,33920,33918,33928,33929,33921,33917],\"每周限定id\":-1,\"坐标X\":13.2,\"坐标Y\":13.8},{\"掉落物品\":[40240,40245,40250,40260,40